<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_card">


    <!-- ========================================= -->
    <!-- ẢNH ĐỊA ĐIỂM -->
    <!-- ========================================= -->

    <ImageView
        android:id="@+id/imgPlace"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="14dp"
        android:contentDescription="Ảnh địa điểm"
        android:scaleType="centerCrop"
        android:src="@drawable/halong_bay" />


    <!-- ========================================= -->
    <!-- TÊN ĐỊA ĐIỂM -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/txtPlaceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Vịnh Hạ Long"
        android:textColor="#12365A"
        android:textSize="19sp"
        android:textStyle="bold" />


    <!-- ========================================= -->
    <!-- ĐỊA CHỈ -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/txtPlaceAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="📍 Quảng Ninh"
        android:textColor="#64748B"
        android:textSize="14sp" />


    <!-- ========================================= -->
    <!-- THÔNG TIN -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/txtPlaceInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="Miền Bắc • Thiên nhiên • ⭐ 4.8"
        android:textColor="#64748B"
        android:textSize="14sp" />


    <!-- ========================================= -->
    <!-- NÚT SỬA / XÓA -->
    <!-- ========================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal">


        <!-- SỬA -->

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="#2878E3"
            android:text="SỬA"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />


        <Space
            android:layout_width="10dp"
            android:layout_height="1dp" />


        <!-- XÓA -->

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="#F0445E"
            android:text="XÓA"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>