<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">


    <!-- ================================================= -->
    <!-- ẢNH VỊNH HẠ LONG -->
    <!-- ================================================= -->

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="Vịnh Hạ Long"
        android:scaleType="centerCrop"
        android:src="@drawable/halong_bay"

        app:layout_constraintHeight_percent="0.42"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================================================= -->
    <!-- LỚP PHỦ TỐI NHẸ -->
    <!-- ================================================= -->

    <View
        android:id="@+id/imageOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#18000000"

        app:layout_constraintTop_toTopOf="@id/imgBackground"
        app:layout_constraintBottom_toBottomOf="@id/imgBackground"
        app:layout_constraintStart_toStartOf="@id/imgBackground"
        app:layout_constraintEnd_toEndOf="@id/imgBackground" />


    <!-- ================================================= -->
    <!-- TÊN ỨNG DỤNG -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/txtAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:gravity="center"

        android:text="DU LỊCH&#10;VIỆT NAM"

        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"

        android:letterSpacing="0.05"

        android:shadowColor="#AA000000"
        android:shadowDx="1"
        android:shadowDy="2"
        android:shadowRadius="6"

        app:layout_constraintTop_toTopOf="@id/imgBackground"
        app:layout_constraintBottom_toBottomOf="@id/imgBackground"
        app:layout_constraintStart_toStartOf="@id/imgBackground"
        app:layout_constraintEnd_toEndOf="@id/imgBackground"

        app:layout_constraintVertical_bias="0.40" />


    <!-- ================================================= -->
    <!-- SLOGAN -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/txtSlogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"

        android:text="Khám phá • Trải nghiệm • Tận hưởng"

        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="italic"

        android:shadowColor="#AA000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4"

        app:layout_constraintTop_toBottomOf="@id/txtAppName"
        app:layout_constraintStart_toStartOf="@id/imgBackground"
        app:layout_constraintEnd_toEndOf="@id/imgBackground" />


    <!-- ================================================= -->
    <!-- PHẦN NỘI DUNG TRẮNG -->
    <!-- ================================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentContainer"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:background="#FFFFFF"

        app:layout_constraintTop_toBottomOf="@id/imgBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ================================================= -->
        <!-- TOÀN BỘ NỘI DUNG -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/mainContent"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="20dp"
            android:layout_marginTop="90dp"
            android:layout_marginEnd="20dp"

            android:gravity="center_horizontal"
            android:orientation="vertical"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- ================================================= -->
            <!-- TIÊU ĐỀ -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtTitle"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center"

                android:text="KHÁM PHÁ VIỆT NAM"

                android:textColor="#0872D9"
                android:textSize="25sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- GẠCH XANH -->
            <!-- ================================================= -->

            <View
                android:id="@+id/titleLine"

                android:layout_width="75dp"
                android:layout_height="3dp"

                android:layout_marginTop="7dp"

                android:background="#1688ED" />


            <!-- ================================================= -->
            <!-- MÔ TẢ -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/txtDescription"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginStart="12dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="12dp"

                android:gravity="center"

                android:text="Khám phá những điểm đến tuyệt đẹp&#10;và tìm kiếm hành trình phù hợp với bạn."

                android:textColor="#718096"
                android:textSize="14sp"

                android:lineSpacingExtra="3dp" />


            <!-- ================================================= -->
            <!-- 3 TÍNH NĂNG -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutFeatures"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="26dp"

                android:gravity="center"
                android:orientation="horizontal">


                <!-- ================================================= -->
                <!-- ĐỊA ĐIỂM HẤP DẪN -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:gravity="center"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"

                        android:background="@drawable/bg_icon_green"

                        android:gravity="center"

                        android:text="▲"
                        android:textColor="#00B884"
                        android:textSize="26sp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:gravity="center"

                        android:text="Địa điểm&#10;hấp dẫn"

                        android:textColor="#263D5A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- GỢI Ý HÀNH TRÌNH -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:gravity="center"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"

                        android:background="@drawable/bg_icon_orange"

                        android:gravity="center"

                        android:text="●"
                        android:textColor="#FF7A00"
                        android:textSize="27sp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:gravity="center"

                        android:text="Gợi ý&#10;hành trình"

                        android:textColor="#263D5A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ================================================= -->
                <!-- MẸO DU LỊCH -->
                <!-- ================================================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"

                    android:gravity="center"
                    android:orientation="vertical">


                    <TextView
                        android:layout_width="64dp"
                        android:layout_height="64dp"

                        android:background="@drawable/bg_icon_blue"

                        android:gravity="center"

                        android:text="✈"
                        android:textColor="#1473E6"
                        android:textSize="25sp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:gravity="center"

                        android:text="Mẹo du lịch&#10;hữu ích"

                        android:textColor="#263D5A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- NÚT BẮT ĐẦU -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnStart"

                android:layout_width="match_parent"
                android:layout_height="58dp"

                android:layout_marginStart="10dp"
                android:layout_marginTop="38dp"
                android:layout_marginEnd="10dp"

                android:backgroundTint="#1488ED"

                android:elevation="5dp"

                android:text="BẮT ĐẦU KHÁM PHÁ   →"

                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"

                app:cornerRadius="24dp" />


        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ================================================= -->
    <!-- SÓNG NGĂN CÁCH ẢNH VÀ NỘI DUNG -->
    <!-- Đặt cuối để sóng hiển thị phía trên contentContainer -->
    <!-- ================================================= -->

    <ImageView
        android:id="@+id/imgWave"

        android:layout_width="0dp"
        android:layout_height="75dp"

        android:contentDescription="@null"

        android:scaleType="fitXY"
        android:src="@drawable/wave_bottom"

        android:translationY="35dp"

        app:layout_constraintBottom_toBottomOf="@id/imgBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>