        <!-- ===================================== -->

        <activity
            android:name=".ExploreActivity"
            android:exported="false" />


        <!-- ===================================== -->
        <!-- CHI TIẾT ĐỊA ĐIỂM -->
        <!-- ===================================== -->

        <activity
            android:name=".PlaceDetailActivity"
            android:exported="false" />


        <!-- ===================================== -->
        <!-- TRANG ADMIN -->
        <!-- ===================================== -->

        <activity
            android:name=".AdminActivity"
            android:exported="false" />


